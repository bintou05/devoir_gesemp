{# templates/approvisionnement/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Gestion des Approvisionnements{% endblock %}

{% block body %}
    <h1>Gestion des Approvisionnements</h1>

    <div style="margin-bottom: 20px;">
        <a href="#" style="padding: 10px 20px; background-color: #007bff; color: white; text-decoration: none; border-radius: 5px;">+ Nouvel approvisionnement</a>
    </div>

    <h2>Liste des Approvisionnements</h2>

    <table border="1" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="background-color: #f2f2f2;">
                <th style="padding: 10px;">Référence</th>
                <th style="padding: 10px;">Date</th>
                <th style="padding: 10px;">Fournisseur</th>
                <th style="padding: 10px;">Montant total</th>
                <th style="padding: 10px;">Statut</th>
                <th style="padding: 10px;">Actions</th>
            </tr>
        </thead>
        <tbody>
        {# Boucle sur les données passées par le contrôleur #}
        {% for appro in approvisionnements %}
            <tr>
                <td style="padding: 10px;">{{ appro.reference }}</td>
                <td style="padding: 10px;">{{ appro.date | date('d/m/Y') }}</td>
                {# Accès au nom du fournisseur via la relation #}
                <td style="padding: 10px;">{{ appro.fournisseur.nom }}</td> 
                {# Formatage du montant en FCFA #}
                <td style="padding: 10px; font-weight: bold;">{{ appro.montantTotal | number_format(0, ',', ' ') }} FCFA</td>
                <td style="padding: 10px;">{{ appro.statut }}</td>
                <td style="padding: 10px;">
                    <a href="#">Voir</a> | <a href="#">Modifier</a> | <a href="#">Supprimer</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div style="margin-top: 20px; border-top: 1px solid #ccc; padding-top: 10px;">
        <p>Total des approvisionnements: <strong>{{ totalApprovisionnements | number_format(0, ',', ' ') }} FCFA</strong></p>
        <p>Nombre d'approvisionnements: <strong>{{ nombreApprovisionnements }}</strong></p>
    </div>

{% endblock %}